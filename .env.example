APP_NAME="Order Management System"
APP_ENV=development
DEBUG=True

# Main Database Connection
# Used by FastAPI and SQLAlchemy
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/database_name

# Optional: Separate Database Connection for Alembic
# If empty, Alembic will use DATABASE_URL
MIGRATION_DATABASE_URL
# Test Database Connection
# Must be separate from the main database
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/order_management_test